{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "gateway": {
      "root": ".",
      "runtime": "container",
      "entrypoint": "Dockerfile.vercel",
      "bindings": [
        {
          "type": "service",
          "service": "runtime",
          "format": "url",
          "env": "SCOUT_API_ORIGIN"
        }
      ]
    },
    "runtime": {
      "root": ".",
      "runtime": "container",
      "entrypoint": "Dockerfile"
    }
  },
  "rewrites": [
    { "source": "/", "destination": { "service": "gateway", "path": "/api/proxy?path=/" } },
    { "source": "/login", "destination": { "service": "gateway", "path": "/api/proxy?path=/login" } },
    { "source": "/logout", "destination": { "service": "gateway", "path": "/api/proxy?path=/logout" } },
    { "source": "/health", "destination": { "service": "gateway", "path": "/api/proxy?path=/health" } },
    { "source": "/api/missions", "destination": { "service": "gateway", "path": "/api/proxy?path=/api/missions" } },
    { "source": "/api/missions/:path*", "destination": { "service": "gateway", "path": "/api/proxy?path=/api/missions/:path*" } },
    { "source": "/api/approvals", "destination": { "service": "gateway", "path": "/api/proxy?path=/api/approvals" } },
    { "source": "/api/approvals/:path*", "destination": { "service": "gateway", "path": "/api/proxy?path=/api/approvals/:path*" } }
  ]
}
