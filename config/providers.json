{
  "policy": {
    "free_only": true,
    "never_bypass_access_controls": true,
    "never_enable_paid_billing": true,
    "official_source_required_for_activation": true,
    "community_sources_are_leads_only": true,
    "production_changes_require_approval": true
  },
  "providers": [
    {
      "id": "gemini",
      "label": "Google Gemini Developer API",
      "docs": "https://ai.google.dev/gemini-api/docs/pricing",
      "release_sources": ["https://ai.google.dev/gemini-api/docs/changelog"],
      "api_key_env": "GEMINI_API_KEY",
      "enabled": true,
      "models": ["gemini-3.7-flash", "gemini-3.6-flash"]
    },
    {
      "id": "groq",
      "label": "Groq",
      "docs": "https://console.groq.com/docs/rate-limits",
      "release_sources": ["https://console.groq.com/docs/changelog"],
      "api_key_env": "GROQ_API_KEY",
      "enabled": true,
      "models": ["openai/gpt-oss-120b", "openai/gpt-oss-20b"]
    },
    {
      "id": "huggingface",
      "label": "Hugging Face Inference Providers",
      "docs": "https://huggingface.co/docs/inference-providers/pricing",
      "api_key_env": "HF_TOKEN",
      "enabled": false,
      "models": []
    }
  ]
}
