FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    SCOUT_WORKSPACE_ROOT=/app \
    SCOUT_HOST=0.0.0.0

WORKDIR /app
COPY . /app

RUN python -m pip install --no-cache-dir --upgrade pip \
    && python -m pip install --no-cache-dir -e . --no-deps \
    && python -m pip install --no-cache-dir -r requirements.lock \
    && mkdir -p /app/state

EXPOSE 3000

# The runtime receives PORT; requests reach this private service through the gateway only.
CMD ["sh", "-c", "python -m autonomous_agent.server --host 0.0.0.0 --port ${PORT:-3000} --root /app"]
